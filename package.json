{
  "name": "beancount-js",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "checks": "turbo run checks",
    "dev": "turbo run dev --filter=@beancount-js/fava",
    "test": "turbo run test:run",
    "test:e2e": "turbo run test:e2e --filter=@beancount-js/fava",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "fmt": "turbo run fmt",
    "check-types": "turbo run check-types"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "@parcel/watcher"]
  },
  "devDependencies": {
    "turbo": "^2.2.3"
  }
}
