{
  "name": "beancount-js",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "checks": "pnpm check:baseline && turbo run checks --filter='!@beancount-js/ui' --filter='!@lapis/ui' --filter='!@beancount-js/fava' --filter='!@beancount-js/fava-beta' && pnpm checks:ui && pnpm checks:compat",
    "checks:ui": "pnpm --filter @beancount-js/ui checks",
    "checks:beta": "pnpm --filter @beancount-js/fava-beta checks",
    "dev": "pnpm storybook",
    "storybook": "pnpm --filter @beancount-js/ui storybook",
    "build-storybook": "pnpm --filter @beancount-js/ui build-storybook",
    "test": "turbo run test:run",
    "test:e2e": "turbo run test:e2e --filter=@beancount-js/fava",
    "test:beta": "pnpm --filter @beancount-js/fava-beta test:run",
    "test:e2e:beta": "pnpm --filter @beancount-js/fava-beta test:e2e",
    "test:e2e:beta:navigation": "pnpm --filter @beancount-js/fava-beta test:e2e:navigation",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "fmt": "turbo run fmt",
    "check-types": "turbo run check-types",
    "fava-parity": "tools/fava-parity/run.sh",
    "dev:reference": "turbo run dev --filter=@beancount-js/fava",
    "dev:legacy-beta": "turbo run dev --filter=@beancount-js/fava-beta",
    "checks:compat": "pnpm --filter @lapis/ui checks && pnpm --filter @beancount-js/forms checks",
    "test:storybook": "pnpm --filter @beancount-js/ui test:storybook",
    "check:baseline": "node scripts/check-app-baseline.mjs"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher"
    ],
    "overrides": {
      "@codemirror/autocomplete": "6.20.3",
      "@codemirror/commands": "6.10.3",
      "@codemirror/lang-sql": "6.10.0",
      "@codemirror/lang-yaml": "6.1.3",
      "@codemirror/language": "6.13.1",
      "@codemirror/lint": "6.9.7",
      "@codemirror/search": "6.7.0",
      "@codemirror/state": "6.7.6",
      "@codemirror/view": "6.43.14",
      "@internationalized/date": "3.12.2",
      "@lapismd/design-core@0.4.0>bits-ui": "2.19.5",
      "svelte": "5.56.9"
    }
  },
  "devDependencies": {
    "turbo": "^2.2.3"
  }
}
