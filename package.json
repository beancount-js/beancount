{
  "name": "beancount-js",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "checks": "pnpm spec:check && pnpm checks:functional",
    "checks:functional": "pnpm check:baseline && turbo run checks --filter='!@beancount-js/ui' && pnpm checks:ui",
    "checks:ui": "pnpm --filter @beancount-js/ui checks",
    "dev": "pnpm storybook",
    "dev:app": "pnpm --filter @beancount-js/app dev",
    "storybook": "pnpm --filter @beancount-js/ui storybook",
    "build-storybook": "pnpm --filter @beancount-js/ui build-storybook",
    "build:app": "pnpm --filter @beancount-js/app build",
    "test": "turbo run test:run",
    "test:e2e": "pnpm --filter @beancount-js/app test:e2e:web",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "fmt": "turbo run fmt",
    "check-types": "turbo run check-types",
    "test:storybook": "pnpm --filter @beancount-js/ui test:storybook",
    "check:baseline": "node scripts/check-app-baseline.mjs",
    "spec:search": "spec-validator search",
    "spec:validate": "spec-validator validate",
    "spec:first": "spec-validator first",
    "spec:check": "spec-validator check",
    "spec:build": "spec-validator build",
    "spec:serve": "spec-validator serve",
    "spec:index": "spec-validator index"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher"
    ],
    "overrides": {
      "@codemirror/autocomplete": "6.20.3",
      "@codemirror/commands": "6.10.3",
      "@codemirror/lang-sql": "6.10.0",
      "@codemirror/lang-yaml": "6.1.3",
      "@codemirror/language": "6.13.1",
      "@codemirror/lint": "6.9.7",
      "@codemirror/search": "6.7.0",
      "@codemirror/state": "6.7.6",
      "@codemirror/view": "6.43.14",
      "@internationalized/date": "3.12.2",
      "@lapismd/design-core@0.4.0>bits-ui": "2.19.5",
      "svelte": "5.56.9"
    }
  },
  "devDependencies": {
    "@lapismd/spec-validator": "^0.2.1",
    "turbo": "^2.2.3"
  }
}
