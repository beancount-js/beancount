{
  "name": "beancount-js",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "checks": "turbo run checks --filter='!@beancount-js/ui'",
    "checks:ui": "pnpm --filter @beancount-js/ui checks",
    "dev": "turbo run dev --filter=@beancount-js/fava",
    "storybook": "pnpm --filter @beancount-js/ui storybook",
    "build-storybook": "pnpm --filter @beancount-js/ui build-storybook",
    "test-storybook": "pnpm --filter @beancount-js/ui test-storybook",
    "test": "turbo run test:run",
    "test:e2e": "turbo run test:e2e --filter=@beancount-js/fava",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "fmt": "turbo run fmt",
    "check-types": "turbo run check-types",
    "fava-parity": "tools/fava-parity/run.sh"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher"
    ]
  },
  "devDependencies": {
    "turbo": "^2.2.3"
  }
}
