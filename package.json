{
  "name": "beancount-js",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "checks": "turbo run checks --filter='!@lapis/ui' --filter='!@beancount-js/fava-beta'",
    "checks:ui": "pnpm --filter @lapis/ui checks",
    "checks:beta": "pnpm --filter @beancount-js/fava-beta checks",
    "dev": "turbo run dev --filter=@beancount-js/fava",
    "dev:beta": "turbo run dev --filter=@beancount-js/fava-beta",
    "storybook": "pnpm --filter @lapis/ui storybook",
    "build-storybook": "pnpm --filter @lapis/ui build-storybook",
    "test-storybook": "pnpm --filter @lapis/ui test-storybook",
    "test": "turbo run test:run",
    "test:e2e": "turbo run test:e2e --filter=@beancount-js/fava",
    "test:beta": "pnpm --filter @beancount-js/fava-beta test:run",
    "test:e2e:beta": "pnpm --filter @beancount-js/fava-beta test:e2e",
    "test:e2e:beta:navigation": "pnpm --filter @beancount-js/fava-beta test:e2e:navigation",
    "test:e2e:beta:visual-reference": "pnpm --filter @beancount-js/fava-beta test:e2e:visual-reference",
    "test:e2e:beta:c006": "pnpm --filter @beancount-js/fava-beta test:e2e:c006",
    "test:ui:c006": "pnpm --filter @lapis/ui test-visual:c006",
    "test:c006": "pnpm test:ui:c006 && pnpm test:e2e:beta:c006",
    "audit:fava-migration": "pnpm --filter @lapis/ui audit:fava-migration",
    "audit:fava-migration:final": "pnpm --filter @lapis/ui audit:fava-migration:final",
    "report:fava-migration": "pnpm --filter @lapis/ui report:fava-migration",
    "report:fava-migration:json": "pnpm --filter @lapis/ui report:fava-migration:json",
    "validate:fava-migration:preflight": "pnpm audit:fava-migration && pnpm test:c006 && pnpm checks:ui && pnpm checks:beta",
    "validate:fava-migration": "pnpm audit:fava-migration:final && pnpm test:c006 && pnpm checks:ui && pnpm checks:beta",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "fmt": "turbo run fmt",
    "check-types": "turbo run check-types",
    "fava-parity": "tools/fava-parity/run.sh"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher"
    ]
  },
  "devDependencies": {
    "turbo": "^2.2.3"
  }
}
