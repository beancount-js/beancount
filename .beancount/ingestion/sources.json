{
  "version": 2,
  "brandfetch": {
    "enabled": false,
    "apiKeySecretRef": "env:BRANDFETCH_API_KEY",
    "clientId": "env:BRANDFETCH_CLIENT_ID",
    "assetMode": "hotlink"
  },
  "sources": [
    {
      "id": "lunchflow",
      "name": "Lunch Flow",
      "kind": "lunchflow",
      "accounts": [],
      "aiEnabled": false,
      "setup": "1. Go to [Lunch Flow](https://lunchflow.app/) and create an API key.\n2. Paste the API key and confirm the base URL below, then save the connection.\n3. Open **Settings → Accounts** to load and link the bank accounts you want to import.",
      "merchantEnrichment": {
        "enabled": true,
        "aiEnabled": false,
        "countryCode": "GB"
      },
      "config": {
        "secretRef": "env:LUNCHFLOW_API_KEY",
        "baseUrl": "https://www.lunchflow.app/api/v1",
        "allowedHosts": [
          "lunchflow.app",
          "www.lunchflow.app"
        ],
        "lookbackDays": 7,
        "includePending": true
      },
      "rules": []
    }
  ]
}
