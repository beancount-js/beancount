{
  "name": "@beancount-js/beanquery",
  "version": "0.1.0",
  "description": "Beancount Query language support",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "vite build",
    "dev": "node -e \"console.log('No dev server in this package')\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "parity:check": "tsx ./scripts/parity-check.ts",
    "fmt": "prettier ./src --write",
    "check:fmt": "prettier ./src --check",
    "check:eslint": "eslint ./src --max-warnings 0",
    "check:eslint:fix": "eslint --fix ./src",
    "check:types": "tsc --noEmit",
    "check:svelte": "node -e \"\"",
    "check:all": "pnpm check:fmt && pnpm check:eslint && pnpm check:types && pnpm check:svelte"
  },
  "exports": {
    "import": "./dist/index.js",
    "require": "./dist/index.cjs"
  },
  "sideEffects": false,
  "dependencies": {
    "@beancount-js/beancount": "workspace:*",
    "@beancount-js/parser": "workspace:*",
    "@codemirror/language": "^6.10.3",
    "@lezer/common": "^1.2.3",
    "@lezer/highlight": "^1.2.1",
    "@lezer/lr": "^1.4.2",
    "luxon": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@lezer/generator": "^1.7.1",
    "@types/luxon": "^3.7.1",
    "dedent": "^1.7.2",
    "@vitest/ui": "^2.1.5",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "md5": "^2.3.0",
    "peggy": "^5.1.0",
    "prettier": "3.3.3",
    "prettier-plugin-jsdoc": "^1.3.0",
    "tslib": "^2.8.1",
    "tsx": "^4.7.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.5"
  },
  "license": "MIT"
}
