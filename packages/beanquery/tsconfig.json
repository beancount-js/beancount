{
  "compilerOptions": {
    "importsNotUsedAsValues": "remove",
    "inlineSources": true,
    "module": "ESNext",
    "target": "es6",
    "allowJs": true,
    "noImplicitAny": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "lib": ["DOM", "ES5", "ES6", "ES7", "ES2019", "ES2022"],
    "checkJs": false,
    "esModuleInterop": true,
    "useDefineForClassFields": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": [
    "src/*.ts",
    "src/parser/parser.spec.ts",
    "src/index.ts",
    "src/query/query_compile.spec.ts",
    "src/query/query_env.ts",
    "src/query/query_env.ts",
    "src/query/query_execute.spec.ts",
    "src/query/query_execute.ts",
    "src/query/compiler.ts"
  ]
}
