{
  "name": "@beancount-js/parser",
  "version": "0.1.0",
  "description": "Beancount parser",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.umd.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "vite build",
    "lint": "eslint ./src",
    "lint:fix": "eslint --fix ./src",
    "check-types": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "fmt": "prettier ./ --write"
  },
  "exports": {
    "import": "./dist/index.js",
    "require": "./dist/index.umd.cjs"
  },
  "dependencies": {
    "@beancount-js/codemirror-lang-beancount": "workspace:*",
    "luxon": "^3.5.0",
    "big.js": "^6.2.1"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/big.js": "^6.2.2",
    "dedent": "^1.5.3",
    "vite-plugin-dts": "^4.3.0",
    "tslib": "^2.6.2",
    "tsx": "^4.7.2",
    "@vitest/ui": "latest",
    "vite": "latest",
    "vitest": "latest",
    "eslint": "^9.14.0",
    "globals": "^15.12.0"
  },
  "license": "MIT"
}
