{
  "name": "@beancount-js/beancount",
  "version": "0.1.0",
  "description": "Beancount Core",
  "type": "module",
  "main": "dist/beancount.js",
  "types": "dist/src/index.d.ts",
  "sideEffects": false,
  "dependencies": {
    "@beancount-js/filters": "workspace:*",
    "@beancount-js/parser": "workspace:*",
    "@tensorflow/tfjs": "^4.22.0",
    "dedent": "^1.7.2",
    "luxon": "^3.7.2",
    "rrule": "^2.8.1",
    "stemmer": "^2.0.1",
    "stopword": "^3.1.4",
    "svelte": "^5.2.7",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "scripts": {
    "build": "vite build",
    "checks": "pnpm fmt:check && pnpm check-types",
    "lint": "eslint ./src --max-warnings 0",
    "lint:fix": "eslint --fix ./src",
    "check-types": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "fmt": "prettier ./src --write",
    "fmt:check": "prettier ./src --check"
  },
  "devDependencies": {
    "@lezer/generator": "^1.7.1",
    "@types/luxon": "^3.7.1",
    "@vitest/ui": "^2.1.5",
    "prettier": "3.3.3",
    "prettier-plugin-jsdoc": "^1.3.0",
    "tslib": "^2.6.2",
    "tsx": "^4.7.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.5"
  },
  "license": "MIT"
}
