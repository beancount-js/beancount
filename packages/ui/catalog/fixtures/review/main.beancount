option "title" "Review Ledger"
option "operating_currency" "GBP"
option "operating_currency" "USD"
2024-01-01 open Assets:Checking GBP
2024-01-01 open Assets:Savings GBP
2024-01-01 open Assets:Foreign:Travel USD
2024-01-01 open Equity:Opening
2024-01-01 open Income:Salary GBP
2024-01-01 open Expenses:Food:Groceries GBP
2024-01-01 open Expenses:Home:Office:EquipmentAndSupplies GBP
2024-01-01 open Expenses:Travel:Accommodation USD
2024-01-01 custom "budget" Expenses:Food:Groceries "monthly" 300 GBP
2024-01-01 query "Expenses by account" "SELECT account, sum(number) WHERE account ~ 'Expenses' GROUP BY account"
2024-01-01 * "Opening balances" #household
  Assets:Checking 10000 GBP
  Assets:Savings 2500 GBP
  Assets:Foreign:Travel 1500 USD
  Equity:Opening -12500 GBP
  Equity:Opening -1500 USD
2024-01-02 * "Example employer" "Salary" #household ; #household/income
  Assets:Checking 3000 GBP
  Income:Salary -3000 GBP
2024-01-03 * "Example hotel" "A deliberately long narration for a multi-currency travel expense" #travel ; #travel/2024
  Expenses:Travel:Accommodation 125 USD
  Assets:Foreign:Travel -125 USD
2024-01-04 * "Example supplier 01" "Review transaction with a long descriptive label 01" #household ; #household/food
  note: "First line\nSecond line for multi-line query results"
  Expenses:Home:Office:EquipmentAndSupplies 10 GBP
  Assets:Checking -10 GBP
