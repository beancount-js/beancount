    "test:storybook": "vitest run --project storybook",
    "check:types": "svelte-check --tsconfig ./tsconfig.json",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "fmt:check": "prettier src catalog .storybook scripts *.ts *.json *.md --check",
    "checks": "pnpm fmt:check && pnpm check:boundaries && pnpm check:types && pnpm test:run && pnpm test:storybook && pnpm build-storybook",
    "prepare:dependencies": "pnpm --dir ../.. exec turbo run build --filter=@beancount-js/ui^..."
  },
