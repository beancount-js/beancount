{
  "name": "@beancount-js/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-visual-delta-source": "node ./scripts/sync-visual-delta-source.mjs",
    "prestorybook": "pnpm sync-visual-delta-source",
    "storybook": "WATCHPACK_POLLING=250 storybook dev -p 6006",
    "prebuild-storybook": "pnpm sync-visual-delta-source",
    "build-storybook": "storybook build",
    "test-unit": "vitest run --project unit",
    "test:foundation-tokens": "vitest run --project unit src/foundation.tokens.spec.ts",
    "test-storybook": "vitest run --project storybook",
    "pretest-visual": "pnpm sync-visual-delta-source",
    "test-visual": "playwright test",
    "test-visual:c006": "pnpm sync-visual-delta-source && VISUAL_STORY_FILTER='ledger-(workspace|settings)-navigation|Ledger (Workspace|Settings) Navigation' playwright test",
    "previsual-delta": "pnpm sync-visual-delta-source",
    "visual-delta": "visual-delta",
    "fava-reference:capture": "tsx scripts/fava-reference/capture.ts",
    "fava-reference:verify": "tsx scripts/fava-reference/verify.ts",
    "audit:fava-migration": "node ./scripts/audit-fava-migration.mjs",
    "audit:fava-migration:final": "node ./scripts/audit-fava-migration.mjs --final",
    "report:fava-migration": "node ./scripts/report-fava-migration.mjs",
    "report:fava-migration:json": "node ./scripts/report-fava-migration.mjs --json",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check-boundaries": "node ./scripts/check-boundaries.mjs",
    "check:no-tailwind": "node ../../scripts/no-tailwind/check-no-tailwind-utilities.mjs --baseline ./no-tailwind-baseline.json src/components",
    "test:no-tailwind": "node --test ../../scripts/no-tailwind/*.test.mjs",
    "fmt": "prettier . --write",
    "fmt:check": "prettier . --check",
    "prechecks": "pnpm sync-visual-delta-source",
    "checks": "pnpm fmt:check && pnpm check-boundaries && pnpm test:no-tailwind && pnpm check:no-tailwind && pnpm check && pnpm test-unit && pnpm test-storybook && pnpm build-storybook"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@beancount-js/beancount": "workspace:*",
    "@beancount-js/filters": "workspace:*",
    "@beancount-js/parser": "workspace:*",
    "@beancount-js/beangulp": "workspace:*",
    "@codemirror/autocomplete": "^6.18.3",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-yaml": "^6.1.1",
    "@codemirror/language": "^6.10.3",
    "@codemirror/lint": "^6.8.3",
    "@codemirror/search": "^6.5.8",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.35.0",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource/source-code-pro": "^5.1.0",
    "@internationalized/date": "^3.6.0",
    "@lezer/common": "^1.2.3",
    "@lezer/highlight": "^1.2.1",
    "@tanstack/table-core": "^8.20.5",
    "bits-ui": "^1.8.0",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "lucide-svelte": "^0.460.1",
    "luxon": "^3.5.6",
    "paneforge": "^1.0.0-next.1",
    "svelte-radix": "^1.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@storybook/addon-a11y": "^10.5.2",
    "@storybook/addon-docs": "^10.5.2",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/addon-vitest": "^10.5.2",
    "@storybook/svelte-vite": "^10.5.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^20.17.7",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "playwright": "^1.52.0",
    "prettier": "3.3.3",
    "prettier-plugin-svelte": "^3.3.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "storybook": "^10.5.2",
    "storybook-addon-tag-badges": "^3.1.0",
    "storybook-addon-visual-delta": "workspace:*",
    "svelte": "^5.2.7",
    "svelte-check": "^4.6.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vite": "^6.2.2",
    "vitest": "^4.1.10"
  },
  "exports": {
    "./app-shell": "./src/components/AppShell.svelte",
    "./shadcn/*": "./src/components/shadcn/*/index.ts",
    "./layout/*.svelte": "./src/components/layout/*.svelte",
    "./pages/*.svelte": "./src/components/pages/*.svelte",
    "./navigation/*.svelte": "./src/components/navigation/*.svelte",
    "./tables/*.svelte": "./src/components/tables/*.svelte",
    "./feedback/*.svelte": "./src/components/feedback/*.svelte",
    "./charts/*.svelte": "./src/components/charts/*.svelte",
    "./dashboard/*.svelte": "./src/components/dashboard/*.svelte",
    "./forms": "./src/components/forms/index.ts",
    "./forms/core": "./src/components/forms/core.ts",
    "./forms/helpers/account-avatar": "./src/components/forms/account-avatar.ts",
    "./forms/helpers/appearance-color": "./src/components/forms/appearance-color.ts",
    "./forms/components/*.svelte": "./src/components/forms/*.svelte",
    "./forms/*.svelte": "./src/components/forms/*.svelte",
    "./tokens": "./src/foundation.tokens.ts",
    "./reset.css": "./src/reset.css",
    "./styles.css": "./src/styles.css"
  }
}
