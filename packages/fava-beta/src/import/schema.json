{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ImporterType",
  "definitions": {
    "ImporterType": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ImporterColumnDefinition"
          }
        },
        "dateFormat": {
          "type": "string"
        },
        "posting": {
          "type": "object",
          "properties": {
            "amount": {
              "$ref": "#/definitions/ImporterPatternDefinition"
            },
            "multiplier": {
              "$ref": "#/definitions/ImporterPatternDefinition"
            },
            "date": {
              "$ref": "#/definitions/ImporterPatternDefinition"
            },
            "narration": {
              "$ref": "#/definitions/ImporterPatternDefinition"
            },
            "payee": {
              "$ref": "#/definitions/ImporterPatternDefinition"
            },
            "tags": {
              "$ref": "#/definitions/ImporterPatternDefinition"
            },
            "links": {
              "$ref": "#/definitions/ImporterPatternDefinition"
            },
            "currency": {
              "$ref": "#/definitions/ImporterPatternDefinition"
            }
          },
          "required": ["amount", "date", "narration"],
          "additionalProperties": false
        },
        "accounts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ImporterAccount"
          }
        }
      },
      "required": [
        "name",
        "version",
        "columns",
        "dateFormat",
        "posting",
        "accounts"
      ],
      "additionalProperties": false
    },
    "ImporterPatternDefinition": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/definitions/ImporterPatternType"
        },
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/definitions/ImporterPatternType"
              }
            ]
          }
        }
      ]
    },
    "ImporterPatternType": {
      "type": "object",
      "properties": {
        "pattern": {
          "type": "string"
        },
        "score": {
          "type": "number",
          "default": 1
        },
        "flags": {
          "type": "string",
          "pattern": "^([igm]+)$"
        },
        "value": {
          "type": ["number", "string"]
        },
        "hidden": {
          "type": "boolean",
          "default": false
        }
      },
      "required": ["pattern"],
      "additionalProperties": false
    },
    "ImporterColumnDefinition": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/ImporterColumn"
          }
        }
      ]
    },
    "ImporterColumn": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "amount",
            "account",
            "date",
            "narration",
            "payee",
            "tags",
            "links",
            "currency"
          ]
        }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "ImporterAccount": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "currency": {
          "type": "string",
          "pattern": "^([A-Z][A-Z0-9'_-]*[A-Z0-9])$"
        },
        "pattern": {
          "$ref": "#/definitions/ImporterPatternDefinition"
        },
        "matchers": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/ImporterPatternDefinition"
          }
        }
      },
      "required": ["name", "pattern", "currency", "matchers"],
      "additionalProperties": false
    }
  }
}
