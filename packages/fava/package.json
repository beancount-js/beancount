{
  "name": "@beancount-js/fava",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "fava.js",
  "scripts": {
    "build": "vite build --mode production",
    "build:server": "BEANCOUNT_STUDIO_RUNTIME=server vite build --mode production",
    "build:web": "BEANCOUNT_STUDIO_RUNTIME=web vite build --mode production",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:svelte5": "node ./scripts/check-svelte5-patterns.mjs",
    "checks": "pnpm fmt:check && pnpm lint && pnpm check:svelte5 && pnpm check",
    "dev": "BEANCOUNT_STUDIO_PROJECT_ROOT=${BEANCOUNT_STUDIO_PROJECT_ROOT:-../..} BEANCOUNT_STUDIO_ENTRY_FILE=${BEANCOUNT_STUDIO_ENTRY_FILE:-sample.beancount} vite",
    "ai:mcp": "node ./scripts/run-ts.mjs ./src/lib/ai/cli/mcp-server.ts",
    "fmt": "prettier ./src ./e2e --write",
    "fmt:check": "prettier ./src ./e2e --check",
    "lint": "eslint ./src --max-warnings 0",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
