  "cases": [
    {
      "begin": "2014-03-05",
      "end": "2014-05-05",
      "interval": "month",
      "expectComplete": [
        "2014-03-01",
        "2014-04-01",
        "2014-05-01",
        "2014-06-01"
      ],
      "expectExact": [
        "2014-03-05",
        "2014-04-01",
        "2014-05-01",
        "2014-05-05"
      ]
    },
    {
      "begin": "2014-01-01",
      "end": "2014-05-01",
      "interval": "month",
      "expectComplete": [
        "2014-01-01",
        "2014-02-01",
        "2014-03-01",
        "2014-04-01",
        "2014-05-01"
      ],
      "expectExact": [
        "2014-01-01",
        "2014-02-01",
        "2014-03-01",
        "2014-04-01",
        "2014-05-01"
      ]
    },
    {
      "begin": "2014-03-05",
      "end": "2014-05-05",
      "interval": "year",
      "expectComplete": [
        "2014-01-01",
        "2015-01-01"
      ],
      "expectExact": [
        "2014-03-05",
        "2014-05-05"
      ]
    },
    {
      "begin": "2014-01-01",
      "end": "2014-05-01",
      "interval": "year",
      "expectComplete": [
        "2014-01-01",
        "2015-01-01"
      ],
      "expectExact": [
        "2014-01-01",
        "2014-05-01"
      ]
    }
  ]
