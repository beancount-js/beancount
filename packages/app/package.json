{
  "name": "@beancount-js/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --mode production",
    "build:server": "BEANCOUNT_STUDIO_RUNTIME=server vite build --mode production",
    "build:web": "BEANCOUNT_STUDIO_RUNTIME=web vite build --mode production",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "checks": "pnpm fmt:check && pnpm check && pnpm test:run && pnpm build:server && pnpm build:web",
    "dev": "BEANCOUNT_STUDIO_PROJECT_ROOT=${BEANCOUNT_STUDIO_PROJECT_ROOT:-../..} BEANCOUNT_STUDIO_ENTRY_FILE=${BEANCOUNT_STUDIO_ENTRY_FILE:-sample.beancount} vite",
    "fmt": "prettier . --write",
    "fmt:check": "prettier . --check",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@beancount-js/server": "workspace:*",
    "@beancount-js/ui": "workspace:*",
    "@beancount-js/web": "workspace:*",
    "@beancount-js/workspace": "workspace:*",
    "mode-watcher": "^1.1.0",
    "svelte": "5.56.9"
  },
  "devDependencies": {
    "@lezer/generator": "^1.8.0",
    "@sveltejs/adapter-node": "^5.3.1",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.15.0",
    "jsdom": "^24.1.3",
    "prettier": "3.3.3",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte-check": "^4.3.1",
    "typescript": "~5.8.3",
    "vite": "6.4.2",
    "vitest": "4.1.8"
  }
}
