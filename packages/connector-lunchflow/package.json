  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.5",
    "prettier": "3.3.3",
    "prettier-plugin-jsdoc": "^1.3.0"
  },
  "license": "MIT"
