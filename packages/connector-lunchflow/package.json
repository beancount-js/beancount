{
  "name": "@beancount-js/connector-lunchflow",
  "version": "0.1.0",
  "description": "Lunch Flow connector for Beancount JS Studio ingestion",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "vite build",
