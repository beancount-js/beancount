@top Journal { 
  entries*
}

@skip { 
  space | 
  Comment space? newline?
}

entries {
  Open |
  Close |
  Commodity |
  PushTag |
  PopTag |
  Balance |
  Pad |
  Note |
  Option | 
  Price |
  Event |
  Custom |
  Plugin |
  Query |
  Include |
  Document |
  DocumentMarkup |
  Transaction
}

OPEN { @extend<Identifier, "open"> }
CLOSE { @extend<Identifier, "close"> }
COMMODITY {@extend<Identifier, "commodity"> }
PUSHTAG { @extend<Identifier, "pushtag"> }
POPTAG{ @extend<Identifier, "poptag"> }
BALANCE { @extend<Identifier, "balance"> }
PAD { @extend<Identifier, "pad"> }
NOTE { @extend<Identifier, "note"> }
PRICE { @extend<Identifier, "price"> }
EVENT { @extend<Identifier, "event"> }
CUSTOM { @extend<Identifier, "custom"> }
OPTION { @extend<Identifier, "option"> }
PLUGIN { @extend<Identifier, "plugin"> }
QUERY { @extend<Identifier, "query"> }
DOCUMENT { @extend<Identifier, "document"> }
INCLUDE { @extend<Identifier, "include"> }


Open { Date OPEN AccountName Currencies? BookingMethod? tx Metadata? }
Close { Date CLOSE AccountName tx Metadata?}
Commodity { Date COMMODITY Currency tx Metadata?}
PushTag { PUSHTAG Tag tx }
PopTag {  POPTAG Tag tx }
Plugin {  PLUGIN String (String | CodeBlock)? tx }
Balance { Date BALANCE AccountName NumberExpr Tolerance? Currency tx Metadata?}
Pad { Date PAD AccountName AccountName tx Metadata?}
Note { Date NOTE AccountName String (Tag | Link)* tx Metadata?  }
Option { OPTION String String tx Metadata?}
Price { Date PRICE Currency Amount tx Metadata? }
Event { Date EVENT String String? tx Metadata? }
Custom { Date CUSTOM String MetaValue*  tx Metadata? }
Query { Date QUERY String (String | CodeBlock) tx Metadata?}
Include { INCLUDE String tx Metadata?}
Document { Date DOCUMENT AccountName String (Tag | Link)* tx Metadata?}

Transaction {
  Date Flag? String? String? (Tag | Link)* tx Metadata? Posting+
}

Posting {
  Flag? AccountName (Amount)? (Cost | CostTotalValue) ? (PostingPrice | TotalCost)? tx Metadata?
}

Currencies {
  (Currency ",")+ Currency |
  Currency
}

MetaValue { NumberExpr | Date | Currency | String | Tag | Link | Bool | AccountName | Identifier }

Attribute { AttributeName  MetaValue* tx }

Metadata {
  Attribute+
}

Amount {
  NumberExpr Currency |
  Currency |
  NumberExpr
}

CostPer { "#" Amount }
CostTotal { NumberExpr "#" Amount }

costAmount {
  CostPer |
  CostTotal |
  Amount
}

costValue { 
  costAmount ("," Date)? "," String |
  costAmount ("," Date)? | 
  String |
  Date
}

Cost { BraceL costValue? BraceR }
CostTotalValue { BraceL Cost  BraceR}
PostingPrice { AT Amount }
TotalCost { ATAT Amount }
Tolerance { TILDE NumberExpr }

@precedence { 
  div @left, times @left, plus @left, minus @left
}

NumberExpr {
  Number |
  NumberExpr !div SLASH NumberExpr |
  NumberExpr !times ASTERISK NumberExpr |
  NumberExpr !plus PLUS NumberExpr |
  NumberExpr !minus MINUS NumberExpr |
  LPAREN NumberExpr RPAREN 
}

Bool { @specialize<Identifier, "true"> | bool | @specialize<Identifier, "false"> }

@tokens {
   AT { "@" }
   ATAT { "@@" }
   BraceL  { "{" }
   BraceR { "}" }
   TILDE { "~"}

   MINUS { "-" }
   PLUS  { "+" }
   SLASH { "/" }
   ASTERISK { "*" }
   LPAREN { '(' }
   RPAREN { ')' }

   space { @whitespace+ }
   bool { "TRUE" | "FALSE" }
   newline { $[\n] }
   sep { "-" | "/" | "."}
   num {$[1-9]$[0-9]?$[0-9]? ("," " "* $[0-9]$[0-9]$[0-9])+ }
   int { num | @digit+ }
   frac { '.' @digit+ }
   tx { space? (newline | @eof ) }
   Tag { "#" $[a-zA-Z0-9_-]+}
   Link { "^" $[a-zA-Z0-9_-]+ }
   Number { (MINUS | PLUS) int frac? | int frac?} 
   Date { @digit @digit @digit @digit sep @digit @digit sep @digit @digit}
   Comment {  ";" ![\n]* }
   String { '"' (!["\\] | "\\" _)* '"' }
  
   BookingMethod {
     '"' ("STRICT" | "STRICT_WITH_SIZE" | "NONE" | "AVERAGE" | "FIFO" | "LIFO" | "HIFO") '"' |
     "STRICT" | "STRICT_WITH_SIZE" | "NONE" | "AVERAGE" | "FIFO" | "LIFO" | "HIFO"
   }

   Currency { $[A-Z]$[A-Z0-9'._-]*$[A-Z0-9] }

   Identifier { $[a-zA-Z_]$[a-zA-Z0-9_-]* }
   
   name { $[A-Z0-9]$[A-Za-z0-9-]* }
   AccountName { $[A-Z]$[a-z]+ ":" (name ":")* name }
   AttributeName { Identifier ":"}

   @precedence { Currency Identifier}
   @precedence { bool Identifier}
   @precedence { AccountName, AttributeName, Identifier}
   @precedence { ATAT, AT }
   @precedence { Number PLUS }
   @precedence { Number MINUS }
   @precedence { bool Currency }
   @precedence { AT, Identifier }
   @precedence { ATAT, Identifier }
   @precedence { BookingMethod, Currency }
   @precedence { BookingMethod, String }
   @precedence { Date, Number }
   @precedence { tx, space }

   @precedence { space, newline }
}

@external propSource beancountHighlighting from "./highlight"
@external tokens flag from "./tokens" { Flag }
@external tokens codeBlock from "./tokens" { CodeBlock }
@external tokens markup from "./tokens" { DocumentMarkup }
