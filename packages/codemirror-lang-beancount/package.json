{
  "name": "@beancount-js/codemirror-lang-beancount",
  "version": "0.1.0",
  "description": "Beancount language support for CodeMirror",
  "scripts": {
    "build": "vite build",
    "checks": "pnpm fmt:check && pnpm lint && pnpm check-types",
    "lint": "eslint ./src --max-warnings 0",
    "lint:fix": "eslint --fix ./src",
    "check-types": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "fmt": "prettier ./src --write",
    "fmt:check": "prettier ./src --check"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "import": "./dist/index.js",
    "require": "./dist/index.cjs"
  },
  "sideEffects": false,
  "dependencies": {
    "@codemirror/language": "^6.10.3",
    "@lezer/common": "^1.2.3",
    "@lezer/highlight": "^1.2.1",
    "@lezer/lr": "^1.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@lezer/generator": "^1.7.1",
    "@vitest/ui": "^2.1.5",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "prettier": "3.3.3",
    "prettier-plugin-jsdoc": "^1.3.0",
    "tslib": "^2.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.5"
  },
  "license": "MIT"
}
